# --- Secrets: never commit. ---
# moomoo login password, trading (unlock) password, API tokens and private keys
# must never enter this repository, in any form, including examples and logs.
.env
.env.*
*.key
*.pem
secrets.yaml
secrets.json
configs/live.yaml

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Local research artefacts (regenerable; keep the repo reviewable) ---
data/raw/
*.parquet

# --- OS ---
Thumbs.db
desktop.ini
.DS_Store

# --- Operator's private financial data: NEVER commit. ---
# Raw probe logs contain account balances, buying power, margin figures, open
# positions and researched-symbol history. Keep them local.
logs/*.json
logs/*.log
!logs/redacted/
# Market-data integrity reports contain no account data - commit them.
!logs/qfq_reconciliation.json
!logs/adjustment_verification.json
# Committed instead: logs/redacted/*.json, produced by tools/redact_logs.py,
# which keeps only capability evidence (what the API supports, quotas, limits).

# --- Bar-level equity curves: multi-MB and fully regenerable ---
# `python tools/run_experiment.py` recreates them. The daily downsample committed
# alongside is what every figure in report_sop.md actually consumes.
reports/equity_validation.csv
reports/equity_test.csv
reports/smoke_equity_daily.csv
